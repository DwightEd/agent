# Core is dependency-free. Copy this file to .env when using docker compose.
# For python directly, export variables in your shell; .env is not auto-loaded.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
DATABASE_PATH=data/researchops.db
HOST=127.0.0.1
PORT=8000
# Add the public domain when behind a reverse proxy, comma-separated, no scheme.
APP_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=0
ALLOW_REGISTRATION=0
# Required for initial account setup when the client is not loopback (e.g. Docker).
BOOTSTRAP_TOKEN=
